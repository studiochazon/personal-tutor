# Production Environment Configuration
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Domain configuration
ORIGIN=https://tutor.novotio.com

# Database configuration (Remote MySQL)
DB_HOST=127.0.0.1
DB_USER=novotio_admin
DB_PASSWORD=your_db_password_here
DB_NAME=personal_tutor
DB_PORT=3306

# Authentication (you'll need to update these with your actual values)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
JWT_SECRET=your_jwt_secret

# OpenAI (you'll need to update these with your actual values)
OPENAI_API_KEY=your_openai_api_key

# Logging
LOG_LEVEL=info
ENABLE_LLM_LOGGING=true