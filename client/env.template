# Local Development Environment Template
# Copy this file to .env and fill in your actual values
# Or source values from secrets.env file

# API Keys (get these from secrets.env)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (Local)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_local_db_password_here
DB_NAME=personal_tutor_ai
DB_PORT=3306

# Authentication (get these from secrets.env)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
JWT_SECRET=your_jwt_secret_here

# Logging
LOG_LEVEL=debug
ENABLE_LLM_LOGGING=true