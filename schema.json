{
  "version": "1.0.0",
  "description": "Personal Tutor AI MVP Schema - Single source of truth for DB and Frontend",
  "database": {
    "tables": {
      "users": {
        "description": "User accounts and authentication",
        "columns": {
          "id": {
            "type": "INT",
            "constraints": "PRIMARY KEY, AUTO_INCREMENT",
            "frontend_type": "number",
            "description": "Unique user identifier"
          },
          "email": {
            "type": "VARCHAR(255)",
            "constraints": "UNIQUE, NOT NULL",
            "frontend_type": "string",
            "description": "User email address"
          },
          "password_hash": {
            "type": "VARCHAR(255)",
            "constraints": "NOT NULL",
            "frontend_type": "string",
            "description": "Hashed password (never store plain text)"
          },
          "name": {
            "type": "VARCHAR(100)",
            "constraints": "NOT NULL",
            "frontend_type": "string",
            "description": "User's display name"
          },
          "created_at": {
            "type": "TIMESTAMP",
            "constraints": "DEFAULT CURRENT_TIMESTAMP",
            "frontend_type": "string",
            "description": "Account creation timestamp"
          },
          "updated_at": {
            "type": "TIMESTAMP",
            "constraints": "DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP",
            "frontend_type": "string",
            "description": "Last update timestamp"
          }
        },
        "indexes": ["email"],
        "relationships": ["has_many: courses", "has_many: progress"]
      },
      "courses": {
        "description": "Learning courses/courses",
        "columns": {
          "id": {
            "type": "INT",
            "constraints": "PRIMARY KEY, AUTO_INCREMENT",
            "frontend_type": "number",
            "description": "Unique course identifier"
          },
          "title": {
            "type": "VARCHAR(255)",
            "constraints": "NOT NULL",
            "frontend_type": "string",
            "description": "Course title"
          },
          "description": {
            "type": "TEXT",
            "constraints": "NULL",
            "frontend_type": "string",
            "description": "Course description"
          },
          "thumbnail_url": {
            "type": "VARCHAR(500)",
            "constraints": "NULL",
            "frontend_type": "string",
            "description": "Course thumbnail image URL"
          },
          "difficulty": {
            "type": "ENUM('beginner', 'intermediate', 'advanced')",
            "constraints": "DEFAULT 'beginner'",
            "frontend_type": "'beginner' | 'intermediate' | 'advanced'",
            "description": "Course difficulty level"
          },
          "estimated_duration": {
            "type": "INT",
            "constraints": "NULL",
            "frontend_type": "number",
            "description": "Estimated completion time in minutes"
          },
          "user_id": {
            "type": "INT",
            "constraints": "FOREIGN KEY REFERENCES users(id)",
            "frontend_type": "number",
            "description": "Course creator"
          },
          "is_published": {
            "type": "BOOLEAN",
            "constraints": "DEFAULT FALSE",
            "frontend_type": "boolean",
            "description": "Whether course is publicly available"
          },
          "created_at": {
            "type": "TIMESTAMP",
            "constraints": "DEFAULT CURRENT_TIMESTAMP",
            "frontend_type": "string",
            "description": "Course creation timestamp"
          },
          "updated_at": {
            "type": "TIMESTAMP",
            "constraints": "DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP",
            "frontend_type": "string",
            "description": "Last update timestamp"
          }
        },
        "indexes": ["user_id", "is_published", "difficulty"],
        "relationships": ["belongs_to: user", "has_many: lessons"]
      },
      "lessons": {
        "description": "Individual lessons within courses",
        "columns": {
          "id": {
            "type": "INT",
            "constraints": "PRIMARY KEY, AUTO_INCREMENT",
            "frontend_type": "number",
            "description": "Unique lesson identifier"
          },
          "course_id": {
            "type": "INT",
            "constraints": "FOREIGN KEY REFERENCES courses(id) ON DELETE CASCADE",
            "frontend_type": "number",
            "description": "Parent course"
          },
          "title": {
            "type": "VARCHAR(255)",
            "constraints": "NOT NULL",
            "frontend_type": "string",
            "description": "Lesson title"
          },
          "content": {
            "type": "TEXT",
            "constraints": "NOT NULL",
            "frontend_type": "string",
            "description": "Lesson content (markdown supported)"
          },
          "video_url": {
            "type": "VARCHAR(500)",
            "constraints": "NULL",
            "frontend_type": "string | null",
            "description": "URL to video content (YouTube, Vimeo, etc.)"
          },
          "video_duration": {
            "type": "INT",
            "constraints": "NULL",
            "frontend_type": "number | null",
            "description": "Video duration in seconds"
          },
          "video_title": {
            "type": "VARCHAR(255)",
            "constraints": "NULL",
            "frontend_type": "string | null",
            "description": "Title of the video content"
          },
          "order_index": {
            "type": "INT",
            "constraints": "NOT NULL",
            "frontend_type": "number",
            "description": "Lesson order within course"
          },
          "estimated_duration": {
            "type": "INT",
            "constraints": "NULL",
            "frontend_type": "number",
            "description": "Estimated reading time in minutes"
          },
          "created_at": {
            "type": "TIMESTAMP",
            "constraints": "DEFAULT CURRENT_TIMESTAMP",
            "frontend_type": "string",
            "description": "Lesson creation timestamp"
          },
          "updated_at": {
            "type": "TIMESTAMP",
            "constraints": "DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP",
            "frontend_type": "string",
            "description": "Last update timestamp"
          }
        },
        "indexes": ["course_id", "order_index"],
        "relationships": ["belongs_to: course", "has_many: progress"]
      },
      "progress": {
        "description": "User progress tracking for lessons",
        "columns": {
          "id": {
            "type": "INT",
            "constraints": "PRIMARY KEY, AUTO_INCREMENT",
            "frontend_type": "number",
            "description": "Unique progress record identifier"
          },
          "user_id": {
            "type": "INT",
            "constraints": "FOREIGN KEY REFERENCES users(id) ON DELETE CASCADE",
            "frontend_type": "number",
            "description": "User who made progress"
          },
          "lesson_id": {
            "type": "INT",
            "constraints": "FOREIGN KEY REFERENCES lessons(id) ON DELETE CASCADE",
            "frontend_type": "number",
            "description": "Lesson that was completed"
          },
          "completed": {
            "type": "BOOLEAN",
            "constraints": "DEFAULT FALSE",
            "frontend_type": "boolean",
            "description": "Whether lesson is marked as completed"
          },
          "completed_at": {
            "type": "TIMESTAMP",
            "constraints": "NULL",
            "frontend_type": "string | null",
            "description": "When lesson was completed"
          },
          "time_spent": {
            "type": "INT",
            "constraints": "NULL",
            "frontend_type": "number | null",
            "description": "Time spent on lesson in seconds"
          },
          "created_at": {
            "type": "TIMESTAMP",
            "constraints": "DEFAULT CURRENT_TIMESTAMP",
            "frontend_type": "string",
            "description": "Progress record creation timestamp"
          },
          "updated_at": {
            "type": "TIMESTAMP",
            "constraints": "DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP",
            "frontend_type": "string",
            "description": "Last update timestamp"
          }
        },
        "indexes": ["user_id", "lesson_id"],
        "unique_constraints": ["user_id, lesson_id"],
        "relationships": ["belongs_to: user", "belongs_to: lesson"]
      }
    }
  },
  "api": {
    "endpoints": {
      "auth": {
        "POST /api/auth/register": {
          "description": "Register new user",
          "body": {
            "email": "string",
            "password": "string",
            "name": "string"
          },
          "response": {
            "success": "boolean",
            "user": "User object",
            "token": "string"
          }
        },
        "POST /api/auth/login": {
          "description": "Login user",
          "body": {
            "email": "string",
            "password": "string"
          },
          "response": {
            "success": "boolean",
            "user": "User object",
            "token": "string"
          }
        },
        "POST /api/auth/logout": {
          "description": "Logout user",
          "response": {
            "success": "boolean"
          }
        }
      },
      "courses": {
        "GET /api/courses": {
          "description": "Get all published courses",
          "query_params": {
            "search": "string (optional)",
            "difficulty": "string (optional)",
            "limit": "number (optional, default: 20)",
            "offset": "number (optional, default: 0)"
          },
          "response": {
            "courses": "Course[]",
            "total": "number"
          }
        },
        "GET /api/courses/:id": {
          "description": "Get single course with lessons",
          "response": {
            "course": "Course",
            "lessons": "Lesson[]"
          }
        },
        "POST /api/courses": {
          "description": "Create new course (authenticated)",
          "body": {
            "title": "string",
            "description": "string (optional)",
            "difficulty": "string (optional)",
            "estimated_duration": "number (optional)"
          },
          "response": {
            "course": "Course"
          }
        },
        "PUT /api/courses/:id": {
          "description": "Update course (authenticated, owner only)",
          "body": {
            "title": "string (optional)",
            "description": "string (optional)",
            "difficulty": "string (optional)",
            "estimated_duration": "number (optional)",
            "is_published": "boolean (optional)"
          },
          "response": {
            "course": "Course"
          }
        },
        "DELETE /api/courses/:id": {
          "description": "Delete course (authenticated, owner only)",
          "response": {
            "success": "boolean"
          }
        }
      },
      "lessons": {
        "GET /api/lessons/:id": {
          "description": "Get single lesson",
          "response": {
            "lesson": "Lesson"
          }
        },
        "POST /api/courses/:courseId/lessons": {
          "description": "Create new lesson (authenticated, course owner only)",
          "body": {
            "title": "string",
            "content": "string",
            "video_url": "string (optional)",
            "video_duration": "number (optional)",
            "video_title": "string (optional)",
            "order_index": "number"
          },
          "response": {
            "lesson": "Lesson"
          }
        },
        "PUT /api/lessons/:id": {
          "description": "Update lesson (authenticated, course owner only)",
          "body": {
            "title": "string (optional)",
            "content": "string (optional)",
            "video_url": "string (optional)",
            "video_duration": "number (optional)",
            "video_title": "string (optional)",
            "order_index": "number (optional)"
          },
          "response": {
            "lesson": "Lesson"
          }
        },
        "DELETE /api/lessons/:id": {
          "description": "Delete lesson (authenticated, course owner only)",
          "response": {
            "success": "boolean"
          }
        }
      },
      "progress": {
        "GET /api/progress": {
          "description": "Get user progress (authenticated)",
          "response": {
            "progress": "Progress[]"
          }
        },
        "POST /api/progress": {
          "description": "Update lesson progress (authenticated)",
          "body": {
            "lesson_id": "number",
            "completed": "boolean",
            "time_spent": "number (optional)"
          },
          "response": {
            "progress": "Progress"
          }
        },
        "GET /api/courses/:courseId/progress": {
          "description": "Get progress for specific course (authenticated)",
          "response": {
            "course_progress": {
              "course": "Course",
              "lessons": "Lesson[]",
              "progress": "Progress[]"
            }
          }
        }
      }
    }
  },
  "frontend": {
    "types": {
      "User": {
        "id": "number",
        "email": "string",
        "name": "string",
        "created_at": "string",
        "updated_at": "string"
      },
      "Course": {
        "id": "number",
        "title": "string",
        "description": "string | null",
        "thumbnail_url": "string | null",
        "difficulty": "'beginner' | 'intermediate' | 'advanced'",
        "estimated_duration": "number | null",
        "user_id": "number",
        "is_published": "boolean",
        "created_at": "string",
        "updated_at": "string"
      },
      "Lesson": {
        "id": "number",
        "course_id": "number",
        "title": "string",
        "content": "string",
        "video_url": "string | null",
        "video_duration": "number | null",
        "video_title": "string | null",
        "order_index": "number",
        "estimated_duration": "number | null",
        "created_at": "string",
        "updated_at": "string"
      },
      "Progress": {
        "id": "number",
        "user_id": "number",
        "lesson_id": "number",
        "completed": "boolean",
        "completed_at": "string | null",
        "time_spent": "number | null",
        "created_at": "string",
        "updated_at": "string"
      }
    },
    "routes": {
      "/": "Homepage with course listing",
      "/courses": "All courses page",
      "/courses/[id]": "Single course page with lesson list",
      "/courses/[courseId]/lessons/[lessonId]": "Single lesson page",
      "/auth/login": "Login page",
      "/auth/register": "Register page",
      "/dashboard": "User dashboard with progress (authenticated)",
      "/create": "Course creation page (authenticated)"
    }
  },
  "validation": {
    "rules": {
      "email": "Valid email format, max 255 characters",
      "password": "Minimum 8 characters, at least one letter and one number",
      "title": "Required, max 255 characters",
      "content": "Required for lessons",
      "order_index": "Must be positive integer",
      "difficulty": "Must be one of: beginner, intermediate, advanced",
      "estimated_duration": "Must be positive integer if provided"
    }
  },
  "notes": {
    "authentication": "Use JWT tokens or SvelteKit sessions",
    "content_format": "Lesson content supports markdown for rich formatting",
    "file_uploads": "Consider using cloud storage (AWS S3, Cloudinary) for images",
    "pagination": "Implement cursor-based pagination for better performance",
    "caching": "Consider Redis for caching frequently accessed data",
    "search": "Implement full-text search using MySQL FULLTEXT or external service"
  }
} 